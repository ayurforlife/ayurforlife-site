3b\u0437\u0432\u0430\u0439\u043a\u0438 \u0433\u043e \u0432\u0441\u0435\u043a\u0438 \u0434\u0435\u043d. \u041d\u0430\u0441\u043b\u0430\u0436\u0434\u0430\u0432\u0430\u043c\u0435 \u0441\u0435 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u0430 \u0432 \u0431\u0430\u043b\u0430\u043d\u0441 \u0441 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u0442\u0430 \u0438 \u0442\u0440\u0438\u0442\u0435 \u0441\u0438 \u0434\u0435\u0446\u0430 \u0438 \u0441\u0435 \u043d\u0430\u0434\u044f\u0432\u0430\u043c\u0435 \u0434\u0430 \u0443\u0441\u043f\u0435\u0435\u043c \u0434\u0430 \u043f\u0440\u0435\u0434\u0430\u0434\u0435\u043c \u0442\u0430\u0437\u0438 \u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u0430\u043d\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u044f \u0438 \u043d\u0430 \u043d\u0430\u0448\u0438\u0442\u0435 \u0433\u043e\u0441\u0442\u0438.<\/p>\n<p>\u201e\u0414\u043e\u043c\u044a\u0442 \u043d\u0430 \u0410\u044e\u0440\u0432\u0435\u0434\u0430\u201c \u0435 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d, \u0437\u0430 \u0434\u0430 \u043f\u043e\u043c\u0430\u0433\u0430 \u0434\u0430 \u0441\u0435 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0435 \u0435\u043d\u0435\u0440\u0433\u0438\u0435\u043d, \u0434\u0443\u0445\u043e\u0432\u0435\u043d \u0438 \u0444\u0438\u0437\u0438\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u0430\u043b\u0430\u043d\u0441 \u043d\u0430 \u0412\u0430\u0442\u0430 \u041f\u0438\u0442\u0430 \u0438 \u041a\u0430\u0444\u0430.\u00a0\u0417\u043b\u0430\u0442\u043d\u0430\u0442\u0430 \u0441\u0440\u0435\u0434\u0430 \u0435 \u043e\u0441\u043d\u043e\u0432\u0435\u043d \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0432 \u0410\u044e\u0440\u0432\u0435\u0434\u0430, \u0437\u0430\u0442\u043e\u0432\u0430 \u043f\u0440\u0438 \u043d\u0430\u0441 \u0432\u0441\u0438\u0447\u043a\u043e \u0435 \u043f\u043b\u0430\u0432\u043d\u043e, \u0431\u0435\u0437 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u043d\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438, \u043d\u0435\u0436\u043d\u043e \u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043e. \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u043c\u0435 \u0432 \u043f\u043e\u043c\u043e\u0449 \u043d\u0430 \u0445\u043e\u0440\u0430, \u0436\u0435\u043b\u0430\u0435\u0449\u0438 \u0434\u0430 \u0437\u0430\u0447\u0435\u043d\u0430\u0442 \u0437\u0434\u0440\u0430\u0432\u043e \u0438 \u043a\u0440\u0430\u0441\u0438\u0432\u043e \u0434\u0435\u0442\u0435, \u043f\u043e\u043c\u0430\u0433\u0430\u043c\u0435 \u043f\u043e \u0432\u0440\u0435\u043c\u0435 \u043d\u0430 \u0431\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0441\u0442, \u0440\u0430\u0436\u0434\u0430\u043d\u0435 \u0438 \u0441\u043b\u0435\u0434 \u0440\u043e\u0434\u0438\u043b\u043d\u0438 \u0433\u0440\u0438\u0436\u0438. <img loading=\"lazy\" data-attachment-id=\"201\" data-permalink=\"https:\/\/ayurvedaforlifeinfo.wordpress.com\/about\/attachment\/1432\/\" data-orig-file=\"https:\/\/ayurvedaforlifeinfo.wordpress.com\/wp-content\/uploads\/2014\/07\/1432.jpg\" data-orig-size=\"4288,2848\" data-comments-opened=\"1\" data-image-meta=\"{&quot;aperture&quot;:&quot;5.3&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;NIKON D5000&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;1362155162&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;80&quot;,&quot;iso&quot;:&quot;800&quot;,&quot;shutter_speed&quot;:&quot;0.016666666666667&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;1&quot;}\" data-image-title=\"1432\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https:\/\/ayurvedaforlifeinfo.wordpress.com\/wp-content\/uploads\/2014\/07\/1432.jpg?w=1024\" class=\" wp-image-201 alignright\" src=\"https:\/\/ayurvedaforlifeinfo.wordpress.com\/wp-content\/uploads\/2014\/07\/1432.jpg?w=226&#038;h=150\" alt=\"1432\" width=\"226\" height=\"150\" srcset=\"https:\/\/ayurvedaforlifeinfo.wordpress.com\/wp-content\/uploads\/2014\/07\/1432.jpg?w=300 300w, https:\/\/ayurved